# Copy to .env and adjust as needed. Used by docker-compose for the consumer/api services.
# Note: esp32/sketch.ino has its own hardcoded broker constants (Wokwi needs an
# internet-reachable broker, so it cannot read this file).

MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors

ELASTICSEARCH_INDEX=iot-data

TEMPERATURE_THRESHOLD=35.0
HUMIDITY_THRESHOLD=80.0
